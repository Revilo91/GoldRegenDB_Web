# Example environment for MCP server
# If you want the server to forward requests to OpenAI, set OPENAI_API_KEY
OPENAI_API_KEY=
# Hugging Face Inference API key (optional)
HUGGINGFACE_API_KEY=
# Ollama local server URL (optional), e.g. http://localhost:11434
OLLAMA_URL=
# Comma-separated provider priority fallback order
PROVIDER_PRIORITY=openai,huggingface,ollama
PORT=5100
