{
  "compilerOptions": {
    // Laufzeit ist Node 22 (siehe .nvmrc, Dockerfile: node:22-alpine).
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "commonjs",
    "moduleResolution": "node",

    // Typprüfung ohne Build: der Produktions-Start bleibt `node src/index.js`
    // (kein tsc-Kompilierschritt, kein dist/). Siehe TYPESCRIPT.md.
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true
  },
  // __tests__/ bewusst ausgeschlossen: die Tests haben kein @types/jest
  // (nicht Teil dieses Issues) und laufen unverändert über Jest/Babel, nicht tsc.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
