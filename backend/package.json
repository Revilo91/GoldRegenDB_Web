{
  "name": "goldregendb-backend",
  "version": "1.0.0",
  "description": "GoldRegenDB REST API",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "sync:fotos": "node scripts/sync-photo-column.js",
    "sync:fotos:dry": "node scripts/sync-photo-column.js --dry-run",
    "dsgvo:retention": "node scripts/dsgvo-retention.js",
    "dsgvo:retention:dry": "node scripts/dsgvo-retention.js --dry-run",
    "test": "jest --forceExit",
    "lint": "eslint src/ scripts/ __tests__/",
    "lint:fix": "eslint src/ scripts/ __tests__/ --fix",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "clearMocks": true,
    "restoreMocks": true,
    "testTimeout": 10000,
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 31,
        "functions": 42,
        "lines": 36,
        "statements": 36
      }
    }
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.3.0",
    "image-size": "^2.0.4",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.19.0",
    "qrcode": "^1.5.1",
    "saxon-js": "^2.7.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "xmllint-wasm": "^5.3.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "qs": "^6.16.0"
  }
}
