{
  "name": "goldregendb-backend",
  "version": "1.0.0",
  "description": "GoldRegenDB REST API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "sync:fotos": "node scripts/sync-photo-column.js",
    "sync:fotos:dry": "node scripts/sync-photo-column.js --dry-run",
    "test": "jest --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "clearMocks": true,
    "restoreMocks": true,
    "testTimeout": 10000
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "image-size": "^1.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.0",
    "pg": "^8.19.0",
    "pdfkit": "^0.13.0",
    "stream-buffers": "^3.0.2"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "supertest": "^7.2.2"
  }
}
