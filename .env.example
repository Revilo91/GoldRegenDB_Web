# Database
DB_PASSWORD=changeme
POSTGRES_DB=goldregendb
POSTGRES_USER=goldregen

# Backend
NODE_ENV=development
PORT=3001
# Für nativen Betrieb (npm run dev) via localhost; Docker-Compose überschreibt
# DATABASE_URL selbst mit dem Netzwerknamen "db" (siehe docker-compose*.yml).
DATABASE_URL=postgresql://goldregen:changeme@localhost:5432/goldregendb
JWT_SECRET=change-this-to-a-long-random-secret

# Kommaseparierte Liste der Origins, die per CORS auf die API zugreifen dürfen.
# Nur nötig, wenn das Frontend von einer anderen Adresse als das Backend geladen
# wird (Dev-Modus). In Produktion liefert Express das Frontend selbst aus –
# diese Requests sind same-origin und brauchen keinen Eintrag.
# Ohne Angabe gelten die lokalen Dev-Origins (localhost:5173 / localhost:3000).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Setzt das Secure-Flag auf dem JWT-Cookie – der Browser sendet es dann nur
# über HTTPS. ERST auf true stellen, wenn ein vorgeschalteter Reverse Proxy
# TLS terminiert (siehe FORCE_HTTPS unten); sonst verwirft der Browser das
# Cookie und niemand kann sich mehr anmelden.
COOKIE_SECURE=false

# Erzwingt HTTPS und aktiviert HSTS, sobald ein Reverse Proxy TLS terminiert
# (Synology Reverse Proxy, docker-compose.proxy.yml o. Ä. – siehe README.md
# "HTTPS auf Synology", Issue #138). HTTP-Requests werden per 301 auf https
# umgeleitet, sofern der Proxy den Header X-Forwarded-Proto setzt. In der
# nativen Entwicklung (npm run dev, docker-compose.dev.yml) unbedingt auf
# false lassen – es gibt dort keinen TLS-terminierenden Proxy davor.
FORCE_HTTPS=false
# Gültigkeitsdauer des HSTS-Headers in Sekunden (nur mit FORCE_HTTPS=true aktiv).
# Standard: 15552000 (180 Tage), wie helmet es empfiehlt.
HSTS_MAX_AGE=15552000

# Anzahl vertrauenswürdiger Proxy-Hops vor der App (Express' "trust proxy").
# Nur setzen, wenn tatsächlich ein Reverse Proxy davorsteht – sonst könnten
# Clients ihre IP/ihr Protokoll per X-Forwarded-*-Header vortäuschen (wirkt
# sich auf Rate-Limiting und FORCE_HTTPS aus). Bei einem einzelnen Proxy davor
# (Caddy/Nginx/Synology Reverse Proxy): 1.
TRUST_PROXY=

# Bestellübersicht (DSGVO) – AES-256-GCM-Schlüssel für Kundendaten-Verschlüsselung.
# Erzeugen mit: openssl rand -hex 32
# WICHTIG: Schlüssel separat von den DB-Backups sichern – ohne ihn sind
# die verschlüsselten Kundendaten unwiederbringlich verloren.
BESTELLUNG_ENCRYPTION_KEY=change-this-to-a-64-char-hex-key
# Version der Datenschutzerklärung, die beim Consent protokolliert wird.
PRIVACY_POLICY_VERSION=2026-01-v1
# Aufbewahrungsfristen für die DSGVO-Anonymisierung (siehe scripts/dsgvo-retention.js)
BESTELLUNG_RETENTION_TAGE_OHNE_RECHNUNG=90
BESTELLUNG_RETENTION_JAHRE_MIT_RECHNUNG=10

# Frontend (für nativen `npm run dev` und docker-compose.dev.yml)
# In Produktion wird /api automatisch same-origin vom Backend ausgeliefert.
VITE_API_URL=http://localhost:3001/api

# Playwright E2E-Tests (siehe /e2e) – gegen eine laufende docker-compose.dev.yml-Instanz
BASE_URL=http://localhost:3000
API_URL=http://localhost:3001/api
TEST_USERNAME=admin
TEST_PASSWORD=admin
