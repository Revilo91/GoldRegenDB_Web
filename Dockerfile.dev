FROM node:22-alpine
WORKDIR /app
# postgresql16-client: pg_dump für das Backup vor Schema-Migrationen (Issue #257),
# Major-Version wie das DB-Image postgres:16-alpine
RUN apk add --no-cache curl postgresql16-client

COPY package*.json ./
COPY backend/package*.json ./backend/
COPY frontend/package*.json ./frontend/

RUN npm install

COPY scripts ./scripts
COPY backend ./backend
COPY frontend ./frontend

EXPOSE 3001 5173

CMD ["sh", "scripts/dev-docker-start.sh"]
