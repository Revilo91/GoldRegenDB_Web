{"nodes": [{"id": "readme", "label": "README.md", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_jwt_secret_graceful_rollover", "label": "JWT_SECRET Graceful Rollover via JWT_SECRET_OLD", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hartes Rotieren wuerde alle Nutzer ausloggen; authenticate() prueft zusaetzlich das alte Secret, signiert wird mit dem neuen; nach 8 h Token-Lebensdauer JWT_SECRET_OLD entfernen."}, {"id": "readme_encryption_key_rotation_grenze", "label": "BESTELLUNG_ENCRYPTION_KEY-Rotation erfordert Re-Encryption", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dauerhaft gespeicherte AES-256-GCM-Daten laufen nicht ab wie Tokens, daher kein Graceful Rollover; rotate-secret.sh erzeugt nur den Schluessel, Migration bewusst ausserhalb des Scopes von Issue #140."}, {"id": "readme_synology_release_paket", "label": "Synology-Release-Paket (goldregendb-synology-*.zip)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enthaelt docker-compose.yml (= synology), .env.example mit IMAGE_TAG, synology-update.sh und db/-Skripte; DATA_DIR als Wurzel fuer data/, backups/, uploads/. IMAGE_TAG ohne fuehrendes v ist Pflicht, kein Rueckfall auf latest."}, {"id": "readme_https_synology_optionen", "label": "HTTPS auf Synology: DSM Reverse Proxy oder Caddy-Overlay", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Option A: DSM Reverse Proxy + Let's Encrypt, FORCE_HTTPS/COOKIE_SECURE/TRUST_PROXY setzen. Option B: docker-compose.proxy.yml mit Caddy setzt diese automatisch."}, {"id": "readme_sql_dump_import", "label": "SQL-Dump-Import (nur COPY-Bloecke)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nimmt pg_dump/pg_dumpall im COPY-Format; Rollen, Passwoerter und Schema-Anweisungen werden ignoriert, aus der Datei wird nie SQL ausgefuehrt. Export als reine Daten-Datei (TRUNCATE, COPY, setval)."}, {"id": "readme_file_secrets_ohne_swarm", "label": "Dateibasierte Secrets statt external Docker Secrets", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "external: true funktioniert nur im Swarm-Modus; Compose mountet file:-Secrets auch ohne Swarm nach /run/secrets/ - realistischer Weg auf Synology."}], "edges": [{"source": "readme_jwt_secret_graceful_rollover", "target": "middleware_auth_jwt_secret_old", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_jwt_secret_graceful_rollover", "target": "middleware_auth_authenticate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_encryption_key_rotation_grenze", "target": "utils_encryptionservice", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_encryption_key_rotation_grenze", "target": "scripts_dsgvo_retention", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_synology_release_paket", "target": "scr