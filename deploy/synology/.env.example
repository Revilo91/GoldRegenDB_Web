# Vorlage für die .env des Synology-Deployments (docker-compose.synology.yml,
# im Release-ZIP als docker-compose.yml). Kopieren nach .env und alle Werte mit
# "change-this"/"changeme" ersetzen – mit Platzhaltern verweigert das Backend
# den Start (backend/src/config/secrets.js).

# Image-Version aus ghcr.io/revilo91/goldregendb, ohne führendes "v". Das
# Release-Paket trägt hier seine eigene Version ein. Pflicht: ohne IMAGE_TAG
# startet Compose nicht. Update auf eine neue Version: ./synology-update.sh 0.3.0
IMAGE_TAG=

# Wurzel für Datenbank (data/), Backups (backups/) und Fotos (uploads/).
# Fehlende Unterordner legt Docker beim Start selbst an.
DATA_DIR=/volume1/docker/goldregendb

# Ports auf der Synology: Web-Oberfläche und direkter Datenbankzugriff.
APP_HOST_PORT=3000
DB_HOST_PORT=15432

# Datenbank. Nur Buchstaben und Ziffern im Passwort (z. B. openssl rand -hex 16):
# Compose setzt es ohne Kodierung in die DATABASE_URL ein, "@", "/" oder ":"
# zerbrechen dort die Verbindungs-URL.
DB_PASSWORD=changeme
POSTGRES_DB=goldregendb
POSTGRES_USER=goldregen

# Port des Backends im Container – nur ändern, wenn es einen Grund gibt.
PORT=3001

# Mindestens 32 Zeichen. Erzeugen mit: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret
# Während einer Secret-Rotation das ALTE JWT_SECRET eintragen (README.md,
# "Secrets rotieren").
# JWT_SECRET_OLD=

# Bestellübersicht (DSGVO) – AES-256-GCM-Schlüssel für Kundendaten.
# Erzeugen mit: openssl rand -hex 32
# WICHTIG: Getrennt von den DB-Backups sichern – ohne ihn sind die
# verschlüsselten Kundendaten verloren.
BESTELLUNG_ENCRYPTION_KEY=change-this-to-a-64-char-hex-key
PRIVACY_POLICY_VERSION=2026-01-v1
BESTELLUNG_RETENTION_TAGE_OHNE_RECHNUNG=90
BESTELLUNG_RETENTION_JAHRE_MIT_RECHNUNG=10

# HTTPS hinter dem Synology Reverse Proxy (README.md, "HTTPS auf Synology"):
# alle drei erst setzen, wenn der Proxy TLS terminiert.
# FORCE_HTTPS=true
# COOKIE_SECURE=true
# TRUST_PROXY=1
# HSTS_MAX_AGE=15552000

# Nur nötig, wenn das Frontend von einer anderen Adresse geladen wird.
# ALLOWED_ORIGINS=

# E-Rechnung – Stammdaten des Rechnungsstellers (docs/E-RECHNUNG.md).
# Steuernummer ODER USt-IdNr. ist Pflicht für E-Rechnungen.
# VERKAEUFER_STEUERNUMMER=
# VERKAEUFER_USTIDNR=
# VERKAEUFER_FIRMA=
# VERKAEUFER_NAME=
# VERKAEUFER_STRASSE=
# VERKAEUFER_PLZ=
# VERKAEUFER_ORT=
# VERKAEUFER_LAND=DE
# VERKAEUFER_TELEFON=
# VERKAEUFER_EMAIL=
# VERKAEUFER_WEBSITE=
# VERKAEUFER_BANK=
# VERKAEUFER_IBAN=
# VERKAEUFER_BIC=
