# Vorlage für die .env des Synology-Deployments (deploy/docker-compose.yml).
# install.sh legt daraus die .env an und erzeugt die leeren Secrets selbst
# (openssl rand -hex 32); bestehende Werte überschreibt es nie.

# Image-Version aus ghcr.io/revilo91/goldregendb (ohne "v"). Setzt install.sh;
# ohne APP_VERSION startet Compose nicht.
APP_VERSION=

# Ports auf der Synology: Web-Oberfläche und direkter Datenbankzugriff.
APP_PORT=3000
DB_HOST_PORT=15432

# Datenbank. Die Verbindungs-URL baut das Backend selbst aus diesen Werten
# (mit URL-Kodierung), Sonderzeichen im Passwort sind also erlaubt.
POSTGRES_PASSWORD=
POSTGRES_DB=goldregendb
POSTGRES_USER=goldregen

# Port des Backends im Container – nur ändern, wenn es einen Grund gibt.
PORT=3001

# Mindestens 32 Zeichen (install.sh erzeugt 64 Hex-Zeichen).
JWT_SECRET=
# Während einer Secret-Rotation das ALTE JWT_SECRET eintragen (README.md,
# "Secrets rotieren").
# JWT_SECRET_OLD=

# Bestellübersicht (DSGVO) – AES-256-GCM-Schlüssel für Kundendaten (64 Hex-Zeichen).
# WICHTIG: Getrennt von den DB-Backups sichern – ohne ihn sind die
# verschlüsselten Kundendaten verloren.
BESTELLUNG_ENCRYPTION_KEY=
PRIVACY_POLICY_VERSION=2026-01-v1
BESTELLUNG_RETENTION_TAGE_OHNE_RECHNUNG=90
BESTELLUNG_RETENTION_JAHRE_MIT_RECHNUNG=10

# HTTPS hinter dem Synology Reverse Proxy (README.md, "HTTPS auf Synology"):
# alle drei erst setzen, wenn der Proxy TLS terminiert.
# FORCE_HTTPS=true
# COOKIE_SECURE=true
# TRUST_PROXY=1
# HSTS_MAX_AGE=15552000

# Nur nötig, wenn das Frontend von einer anderen Adresse geladen wird.
# ALLOWED_ORIGINS=

# Schema-Migrationen: Vor ausstehenden Migrationen legt das Backend ein
# pg_dump-Backup an (nach /backups/migrations). Nur auf true setzen, wenn ein
# eigenes, aktuelles Backup existiert; dann wird nur gewarnt.
# MIGRATION_SKIP_BACKUP=false

# „Jetzt sichern“: Zielordner im Container. Ein Ort außerhalb von /backups
# braucht ein eigenes Volume in der docker-compose.yml.
# MANUAL_BACKUP_DIR=/backups/manual

# Backup-Status (Issue #289, Teil 1): backup.sh schreibt nach jedem Lauf
# backups/backup-status.json; /api/health meldet daraus backup.status
# (ok/veraltet/fehler/unbekannt). "veraltet" = letzter Lauf älter als diese
# Stunden.
# BACKUP_MAX_ALTER_STUNDEN=26
# Optional, Kanal frei wählbar: bei FEHLER sendet backup.sh einen HTTP-POST mit
# Klartext-Body an diese URL (z. B. ntfy oder ein Home-Assistant-Webhook).
# Leer = aus. Die URL kann ein Token enthalten: nur in der .env, nie committen.
# BACKUP_WEBHOOK_URL=

# Maximale Anzahl paralleler PostgreSQL-Verbindungen (Standard 25).
# DB_POOL_MAX=25

# E-Rechnung – Stammdaten des Rechnungsstellers (docs/E-RECHNUNG.md).
# Steuernummer ODER USt-IdNr. ist Pflicht für E-Rechnungen.
# VERKAEUFER_STEUERNUMMER=
# VERKAEUFER_USTIDNR=
# VERKAEUFER_FIRMA=
# VERKAEUFER_NAME=
# VERKAEUFER_STRASSE=
# VERKAEUFER_PLZ=
# VERKAEUFER_ORT=
# VERKAEUFER_LAND=DE
# VERKAEUFER_TELEFON=
# VERKAEUFER_EMAIL=
# VERKAEUFER_WEBSITE=
# VERKAEUFER_BANK=
# VERKAEUFER_IBAN=
# VERKAEUFER_BIC=
